# Copy this file to .env and fill it in. Never commit .env.
# docs/how-to/local-setup.md explains each setting.

# Google sign-in. Both are needed for real sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Google emails that may start the first family, separated by commas.
ALLOWED_EMAILS=

# Gmail for invites, recovery links and PIN reset codes. Without them no email is sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 1 turns on the test sign-in at /test/sign-in, on localhost only. Never set it on the server.
TEST_ROUTES=

# Where the SQLite file lives. Leave empty for data/rocket-rewards.db.
DATABASE_FILE=
